# Copia este archivo como ".env" y llena los valores. El archivo .env NUNCA se sube a GitHub.

# 1 = modo prueba: el formulario funciona pero NO crea pedidos en Shopify (usa un producto de ejemplo).
# 0 = modo real: crea pedidos de verdad. En Render va en 0.
MODO_PRUEBA=1

# Tu tienda, en formato nombre.myshopify.com
SHOPIFY_TIENDA=

# Llaves de la app de Shopify. Usa UNA de las dos formas:
#  a) Token de acceso (empieza por shpat_)
SHOPIFY_TOKEN=
#  b) ID de cliente y secreto de la app (Dev Dashboard de Shopify)
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=

# Direcciones de tu tienda desde donde se permite enviar el formulario, separadas por coma.
# Ej: https://www.rebajitas.com,https://rebajitas.myshopify.com
TIENDA_ORIGENES=
